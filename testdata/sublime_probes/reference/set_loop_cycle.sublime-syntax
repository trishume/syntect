%YAML 1.2
---
name: set_loop_cycle
scope: source.set-loop-cycle
file_extensions: [set_loop_cycle]
hidden: true
version: 2
contexts:
  main:
    - match: (?=t)
      set: first
    - match: '[a-z]'
      scope: in.main
  first:
    - match: (?=t)
      set: second
    - match: '[a-z]'
      scope: in.first
  second:
    - match: (?=t)
      set: first
    - match: '[a-z]'
      scope: in.second
